# ─── Contact form email ──────────────────────────────────────────────────────
# The form posts to /api/contact, which sends the message on with Resend.
#
# 1. Create a free account at https://resend.com
# 2. Add and verify the domain (Resend gives you DNS records to add alongside
#    the ones already pointing at Vercel)
# 3. Create an API key and paste it below
# 4. Add all three values in Vercel under Settings → Environment Variables

RESEND_API_KEY=

# Must be an address at the verified domain, e.g. website@miki4.com
CONTACT_FROM_EMAIL=

# Where enquiries land. Defaults to site.contact.email if left blank.
CONTACT_TO_EMAIL=

# ─── Site URL ────────────────────────────────────────────────────────────────
# Used for canonical URLs, the sitemap and social preview images.
NEXT_PUBLIC_SITE_URL=https://miki4.com
